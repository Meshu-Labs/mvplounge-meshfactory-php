{
    "name": "mvplounge/meshfactory",
    "description": "Meshu® Labs | MVP Lounge - DOM Element Factory for PHP.",
    "type": "library",
    "time": "2026-05-27",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "php",
        "meshu",
        "meshu labs",
        "factory UI"
    ],
    "homepage": "https://start.meshu.us",
    "authors": [
        {
            "name": "Lawrence Ball",
            "email": "lball@meshu.us",
            "homepage": "https://www.larryeball.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "info@meshu.us"
    },
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "MvpLounge\\MeshFactory\\": "src/MvpLounge/MeshFactory/"
        },
        "classmap": [
            "src/MvpLounge/MeshFactory/"
        ],
        "exclude-from-classmap": [
            ".instructions.md",
            "/AGENTS.md",
            "/docs/",
            "/sandbox/",
            "/src/MvpLounge/Sandbox/"
        ]
    },
    "archive": {
        "exclude": [
            "/.github",
            "/docs",
            "/sandbox",
            "/src/MvpLounge/Sandbox",
            "/AGENTS.md",
            "/.instructions.md",
            "/.vscode",
            "/.tmp",
            "/vendor",
            "/composer.lock",
            "/.gitignore"
        ]
    },
    "config": {
        "sort-packages": true
    }
}