{
    "name": "mvplounge/meshfactory",
    "description": "Meshu® Labs | MVP Lounge - DOM Element Factory for PHP.",
    "type": "library",
    "time": "2026-05-27",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "meshu",
        "meshu labs"
    ],
    "homepage": "https://start.meshu.us",
    "authors": [
        {
            "name": "Lawrence Ball",
            "email": "lball@meshu.us",
            "homepage": "https://www.larryeball.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "info@meshu.us"
    },
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "MvpLounge\\MeshFactory\\": "src/Labs/MeshFactory/"
        },
        "classmap": [
            "src/Labs/MeshFactory/"
        ],
        "exclude-from-classmap": [
            ".instructions.md",
            "/AGENTS.md",
            "/docs/",
            "/sandbox/",
            "/src/Sandbox/"
        ]
    },
    "archive": {
        "exclude": [
            "/*",
            "!/composer.json",
            "/.gitignore",
            "/.gitattributes",
            "/.github",
            "/.github/**",
            "/.vscode",
            "/.vscode/**",
            "/README.md",
            "/CHANGELOG.md",
            "/AGENTS.md",
            "/.instructions.md",
            "/instructions.md",
            "/src/*",
            "!/src/Labs/",
            "/src/Labs/*",
            "!/src/Labs/MeshFactory/",
            "!/src/Labs/MeshFactory/**"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "@php src/Sandbox/MeshFactory/run-all.php",
        "inventory": "@php src/Sandbox/MeshFactory/_shared/generate-element-inventory.php --write",
        "artifact": "@php scripts/build-artifact.php"
    },
    "scripts-descriptions": {
        "test": "Run the full MeshFactory sandbox suite.",
        "inventory": "Regenerate docs/architecture/AX-element-factory-inventory.md from the code.",
        "artifact": "Build a Composer artifact zip (pass -- --version=dev-local --out=<dir>)."
    }
}