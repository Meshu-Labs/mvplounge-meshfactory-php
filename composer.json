{
    "name": "mvplounge/meshfactory",
    "description": "Meshu® Labs | MVP Lounge - DOM Element Factory for PHP.",
    "type": "library",
    "time": "2026-05-27",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "meshu",
        "meshu labs"
    ],
    "homepage": "https://start.meshu.us",
    "authors": [
        {
            "name": "Lawrence Ball",
            "email": "lball@meshu.us",
            "homepage": "https://www.larryeball.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "info@meshu.us"
    },
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "MvpLounge\\MeshFactory\\": "src/Labs/MeshFactory/"
        },
        "classmap": [
            "src/Labs/MeshFactory/"
        ],
        "exclude-from-classmap": [
            ".instructions.md",
            "/AGENTS.md",
            "/docs/",
            "/sandbox/",
            "/src/Sandbox/"
        ]
    },
    "archive": {
        "exclude": [
            "/*",
            "!/README.md",
            "!/src/",
            "/src/*",
            "!/src/Labs/",
            "/src/Labs/*",
            "!/src/Labs/MeshFactory/",
            "!/src/Labs/MeshFactory/**"
        ]
    },
    "config": {
        "sort-packages": true
    }
}